{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "supertokens": {
      "type": "object",
      "properties": {
        "apiKeys": {
          "type": "string",
          "pattern": "^([A-Za-z0-9=-]{20,}( *, *[A-Za-z0-9=-]{20,})*)?$",
          "description": "Comma-separated, each at least 20 characters of A-Z a-z 0-9 = -"
        },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 },
        "logLevel": { "type": "string", "enum": ["", "DEBUG", "INFO", "WARN", "ERROR", "NONE"] },
        "telemetry": { "type": "boolean" },
        "schemaCheckStrictMode": { "type": "boolean" }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "uri": { "type": "string", "pattern": "^(postgres(ql)?://.+)?$" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 },
        "schema": { "type": "string" }
      }
    },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "shutdownDelaySeconds": { "type": "integer", "minimum": 0 },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 }
  }
}
