{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1, "maximum": 6, "description": "1 to 6 replicas; fixed after the first install." },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "cluster": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^$|^[0-9]{1,39}$",
          "description": "Decimal cluster ID as a string, e.g. --set-string cluster.id=..."
        }
      }
    },
    "dataFile": {
      "type": "object",
      "properties": {
        "onMissing": { "type": "string", "enum": ["auto", "format", "recover"] }
      }
    },
    "tigerbeetle": {
      "type": "object",
      "properties": {
        "cacheGrid": { "type": "string", "pattern": "^[0-9]+(KiB|MiB|GiB)$" },
        "development": { "type": "boolean" },
        "extraArgs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "clusterDomain": { "type": "string", "minLength": 1 },
    "replicaServices": {
      "type": "object",
      "properties": {
        "clusterIPs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "annotations": { "type": "object" }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "items": { "type": "string" } },
        "size": { "type": "string", "minLength": 1 },
        "annotations": { "type": "object" }
      }
    },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "podAntiAffinityPreset": { "type": "string", "enum": ["soft", "hard", "none"] },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "priorityClassName": { "type": "string" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "minReadySeconds": { "type": "integer", "minimum": 0 },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "readinessProbe": { "type": "object" },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "bootstrap": {
      "type": "object",
      "properties": {
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "resources": { "type": "object" },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" },
            "labels": { "type": "object" }
          }
        }
      }
    }
  }
}
