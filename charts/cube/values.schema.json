{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "apiSecret": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "datasource": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": [
            "string",
            "integer"
          ]
        },
        "name": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretPasswordKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "model": {
      "type": "object",
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "existingConfigMap": {
          "type": "string"
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "extraEnvFrom": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "api": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        },
        "startupProbe": {
          "type": "object"
        },
        "livenessProbe": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        }
      }
    },
    "refreshWorker": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "resources": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        }
      }
    },
    "cubestore": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "variant": {
              "type": "string",
              "enum": [
                "",
                "arm64v8",
                "non-avx"
              ]
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "workers": {
          "type": "integer",
          "minimum": 1
        },
        "storage": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "",
                "s3",
                "gcs",
                "minio",
                "sharedVolume"
              ]
            },
            "s3": {
              "type": "object",
              "properties": {
                "bucket": {
                  "type": "string"
                },
                "region": {
                  "type": "string"
                },
                "subPath": {
                  "type": "string"
                }
              }
            },
            "gcs": {
              "type": "object",
              "properties": {
                "bucket": {
                  "type": "string"
                },
                "subPath": {
                  "type": "string"
                }
              }
            },
            "minio": {
              "type": "object",
              "properties": {
                "endpoint": {
                  "type": "string",
                  "pattern": "^$|^https?://"
                },
                "bucket": {
                  "type": "string"
                },
                "region": {
                  "type": "string"
                },
                "subPath": {
                  "type": "string"
                }
              }
            },
            "sharedVolume": {
              "type": "object",
              "properties": {
                "existingClaim": {
                  "type": "string"
                },
                "create": {
                  "type": "boolean"
                },
                "size": {
                  "type": "string"
                },
                "storageClass": {
                  "type": "string"
                },
                "accessModes": {
                  "type": "array"
                }
              }
            }
          }
        },
        "external": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "router": {
          "type": "object",
          "properties": {
            "resources": {
              "type": "object"
            }
          }
        },
        "worker": {
          "type": "object",
          "properties": {
            "resources": {
              "type": "object"
            }
          }
        },
        "extraEnv": {
          "type": "array"
        },
        "extraEnvFrom": {
          "type": "array"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array"
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "automount": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    }
  }
}
