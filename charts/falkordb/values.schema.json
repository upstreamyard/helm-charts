{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "architecture": { "type": "string", "enum": ["standalone", "replication"] },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "clusterDomain": { "type": "string", "minLength": 1 },
    "auth": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "password": { "type": "string", "pattern": "^[^\\n\\r]*$" },
        "existingSecret": { "type": "string" },
        "existingSecretPasswordKey": { "type": "string", "minLength": 1 }
      }
    },
    "config": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z_]+$" },
      "additionalProperties": { "type": ["integer", "string", "null"] }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "items": { "type": "string" } },
        "size": { "type": "string", "minLength": 1 },
        "annotations": { "type": "object" }
      }
    },
    "durability": {
      "type": "object",
      "properties": {
        "appendonly": { "type": "boolean" },
        "appendfsync": { "type": "string", "enum": ["everysec", "always", "no"] },
        "save": { "type": "string", "pattern": "^([0-9]+ [0-9]+( [0-9]+ [0-9]+)*)?$" }
      }
    },
    "extraConfig": { "type": "string" },
    "replication": {
      "type": "object",
      "properties": {
        "minReplicasToWrite": { "type": "integer", "minimum": 0 },
        "minReplicasMaxLag": { "type": "integer", "minimum": 1 }
      }
    },
    "sentinel": {
      "type": "object",
      "properties": {
        "masterSet": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "quorum": { "type": ["integer", "string"], "pattern": "^[0-9]*$", "minimum": 1 },
        "downAfterMilliseconds": { "type": "integer", "minimum": 100 },
        "failoverTimeout": { "type": "integer", "minimum": 1000 },
        "extraConfig": { "type": "string" },
        "resources": { "type": "object" }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "extraEnv": { "type": "array" },
        "resources": { "type": "object" },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" },
            "labels": { "type": "object" }
          }
        }
      }
    },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "annotations": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "probes": { "type": "object" },
    "podDisruptionBudget": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "podAntiAffinityPreset": { "type": "string", "enum": ["", "soft", "hard"] },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "priorityClassName": { "type": "string" }
  }
}
