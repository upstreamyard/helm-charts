{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "config": {
      "type": "object",
      "properties": {
        "version": { "type": "integer" },
        "endpoints": { "type": "array" },
        "extra_config": { "type": "object" }
      }
    },
    "flexibleConfig": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "template": { "type": "string" },
        "settings": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9_-]+$" },
          "additionalProperties": { "type": "object" }
        },
        "partials": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9._-]+$" },
          "additionalProperties": { "type": "string" }
        },
        "templates": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9._-]+$" },
          "additionalProperties": { "type": "string" }
        },
        "existingSettingsConfigMap": { "type": "string" },
        "existingPartialsConfigMap": { "type": "string" },
        "existingTemplatesConfigMap": { "type": "string" }
      }
    },
    "existingConfigMap": { "type": "string" },
    "existingConfigMapKey": { "type": "string" },
    "lint": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "resources": { "type": "object" }
      }
    },
    "secretEnv": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "existingSecret": { "type": "string" },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "usageStats": { "type": "boolean" },
    "tls": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingSecret": { "type": "string" }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
            "labels": { "type": "object" }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodePort": { "type": ["integer", "null"] },
        "annotations": { "type": "object" },
        "externalTrafficPolicy": { "enum": ["", "Cluster", "Local"] }
      }
    },
    "ingress": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "hosts": { "type": "array" }, "tls": { "type": "array" } } },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "parentRefs": { "type": "array" },
        "hostnames": { "type": "array", "items": { "type": "string" } },
        "rules": { "type": "array" },
        "annotations": { "type": "object" }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "from": { "type": "array" },
        "metricsFrom": { "type": "array" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "shutdownDelaySeconds": { "type": "integer", "minimum": 0 },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
    "updateStrategy": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "tmpSizeLimit": { "type": "string", "pattern": "^[0-9]+(Ki|Mi|Gi)?$" },
    "tests": { "type": "object", "properties": { "path": { "type": "string", "pattern": "^$|^/" } } }
  }
}
