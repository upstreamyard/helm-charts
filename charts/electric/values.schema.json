{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "electric": {
      "type": "object",
      "properties": {
        "secret": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 },
        "insecure": { "type": "boolean" },
        "replicationStreamId": {
          "type": "string",
          "pattern": "^([a-z_][a-z0-9_]*)?$",
          "description": "Lower-case letters, digits and underscores, not starting with a digit"
        },
        "logLevel": { "type": "string", "enum": ["", "error", "warning", "info", "debug"] }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "pattern": "^(postgres(ql)?://.+)?$" },
        "pooledUrl": { "type": "string", "pattern": "^(postgres(ql)?://.+)?$" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 },
        "existingSecretPooledUrlKey": { "type": "string" }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany"] }
        },
        "size": { "type": "string", "minLength": 1 },
        "annotations": { "type": "object" },
        "keep": { "type": "boolean" }
      }
    },
    "rolloutStrategy": { "type": "string", "enum": ["", "Recreate", "RollingUpdate"] },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "not": { "const": 3000 } },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" },
            "labels": { "type": "object" }
          }
        }
      }
    },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "readinessProbe": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 }
  }
}
