{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openaiApiKey": { "type": "string" },
        "nvidiaApiKey": { "type": "string" },
        "existingSecret": { "type": "string" },
        "baseUrl": { "type": "string", "pattern": "^(https?://.+)?$" },
        "engine": { "type": "string" }
      }
    },
    "configs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      }
    },
    "existingConfigMaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "configMap"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "configMap": { "type": "string", "minLength": 1 }
        }
      }
    },
    "defaultConfigId": { "type": "string" },
    "checkConfig": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "resources": { "type": "object" }
      }
    },
    "chatUI": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "logLevel": { "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL", "debug", "info", "warning", "error", "critical"] },
    "telemetry": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "cors": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowedOrigins": { "type": "array", "items": { "type": "string" } }
      }
    },
    "opentelemetry": {
      "type": "object",
      "properties": {
        "endpoint": { "type": "string", "pattern": "^(https?://.+)?$" },
        "serviceName": { "type": "string" }
      }
    },
    "extraArgs": { "type": "array", "items": { "type": "string" } },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowFrom": { "type": "array" }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "preStopSleepSeconds": { "type": "integer", "minimum": 0 }
  }
}
