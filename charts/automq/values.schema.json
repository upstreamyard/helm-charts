{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "storageClass": { "type": "string" },
        "size": { "type": "string", "minLength": 1 },
        "accessModes": { "type": "array", "items": { "type": "string" } },
        "annotations": { "type": "object" }
      }
    },
    "nodeGroup": {
      "type": "object",
      "properties": {
        "heapOpts": { "type": "string", "minLength": 1 },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "podAntiAffinityPreset": { "type": "string", "enum": ["", "soft", "hard"] },
        "topologySpreadConstraints": { "type": "array" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" }
      }
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "clusterDomain": { "type": "string", "minLength": 1 },
    "clusterId": { "type": "string", "pattern": "^([A-Za-z0-9_-]{22})?$" },
    "s3": {
      "type": "object",
      "properties": {
        "dataBucket": { "type": "string" },
        "opsBucket": { "type": "string" },
        "region": { "type": "string", "minLength": 1 },
        "endpoint": { "type": "string", "pattern": "^(https?://.+)?$" },
        "pathStyle": { "type": "boolean" },
        "authType": { "type": "string", "enum": ["static", "instance"] },
        "accessKey": { "type": "string" },
        "secretKey": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretAccessKeyKey": { "type": "string", "minLength": 1 },
        "existingSecretSecretKeyKey": { "type": "string", "minLength": 1 }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
              "password": { "type": "string" }
            }
          }
        },
        "interBrokerUser": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "interBrokerPassword": { "type": "string" },
        "existingSecret": { "type": "string" }
      }
    },
    "controller": {
      "allOf": [{ "$ref": "#/definitions/nodeGroup" }],
      "properties": {
        "replicas": { "type": "integer", "enum": [1, 3, 5] },
        "controllerOnly": { "type": "boolean" },
        "persistence": { "$ref": "#/definitions/persistence" }
      }
    },
    "broker": {
      "allOf": [{ "$ref": "#/definitions/nodeGroup" }],
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "persistence": { "$ref": "#/definitions/persistence" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" },
            "labels": { "type": "object" }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" }
  }
}
