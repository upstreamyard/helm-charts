{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "envList": {
      "type": "array",
      "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } }
    },
    "secretRef": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "variant": {
      "type": "string",
      "description": "Hardware variant of LocalAI's official image, appended to the tag.",
      "enum": ["", "gpu-nvidia-cuda-12", "gpu-nvidia-cuda-13", "gpu-hipblas", "gpu-intel", "gpu-vulkan", "nvidia-l4t-arm64", "nvidia-l4t-arm64-cuda-13"]
    },
    "probe": { "type": "object" },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadWriteOncePod", "ReadOnlyMany"] }
        },
        "size": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "mode": { "type": "string", "enum": ["standalone", "distributed"] },
    "replicaCount": { "type": "integer", "minimum": 0, "description": "More than 1 requires mode=distributed and a ReadWriteMany volume." },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "variant": { "$ref": "#/definitions/variant" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "apiKey": {
      "allOf": [{ "$ref": "#/definitions/secretRef" }],
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "value": { "type": "string" }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "registrationMode": { "type": "string", "enum": ["invite", "approval", "open"] },
        "admin": {
          "type": "object",
          "properties": {
            "email": { "type": "string", "pattern": "^$|^[^@\\s]+@[^@\\s]+$" },
            "password": { "type": "string", "pattern": "^$|^.{12,72}$", "description": "12 to 72 characters." }
          }
        },
        "hmacSecret": { "type": "string" },
        "existingSecret": { "type": "string" }
      }
    },
    "database": {
      "allOf": [{ "$ref": "#/definitions/secretRef" }],
      "type": "object",
      "properties": {
        "url": { "type": "string" }
      }
    },
    "distributed": {
      "allOf": [{ "$ref": "#/definitions/secretRef" }],
      "type": "object",
      "properties": {
        "nats": {
          "allOf": [{ "$ref": "#/definitions/secretRef" }],
          "type": "object",
          "properties": {
            "url": { "type": "string", "pattern": "^$|^(nats|tls)://" }
          }
        },
        "registrationToken": { "type": "string" },
        "autoApproveNodes": { "type": "boolean" }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "variant": { "$ref": "#/definitions/variant" }
          }
        },
        "labels": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
        "vramBudget": { "type": "string", "pattern": "^$|^[0-9]+(\\.[0-9]+)?(%|[KMGT]i?B?)?$" },
        "resources": { "type": "object" },
        "persistence": { "$ref": "#/definitions/persistence" },
        "extraEnv": { "$ref": "#/definitions/envList" },
        "extraEnvFrom": { "type": "array" },
        "extraVolumes": { "type": "array" },
        "extraVolumeMounts": { "type": "array" },
        "runtimeClassName": { "type": "string" },
        "shareProcessNamespace": { "type": "boolean" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "startupProbe": { "$ref": "#/definitions/probe" },
        "livenessProbe": { "$ref": "#/definitions/probe" },
        "readinessProbe": { "$ref": "#/definitions/probe" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "pdb": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "maxUnavailable": { "type": ["integer", "string"] }
          }
        },
        "networkPolicy": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "extraIngress": { "type": "array" }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "properties": {
        "install": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "configs": {
          "type": "array",
          "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 } } }
        }
      }
    },
    "baseUrl": { "type": "string", "pattern": "^$|^https?://" },
    "extraEnv": { "$ref": "#/definitions/envList" },
    "extraEnvFrom": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "persistence": {
      "allOf": [{ "$ref": "#/definitions/persistence" }],
      "type": "object",
      "properties": {
        "existingClaim": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "updateStrategy": { "type": "object" },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "ingress": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
    "metrics": {
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" },
            "labels": { "type": "object" }
          }
        }
      }
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "serviceAccount": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "startupProbe": { "$ref": "#/definitions/probe" },
    "livenessProbe": { "$ref": "#/definitions/probe" },
    "readinessProbe": { "$ref": "#/definitions/probe" },
    "resources": { "type": "object" },
    "runtimeClassName": { "type": "string" },
    "shareProcessNamespace": { "type": "boolean" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "tmpSizeLimit": { "type": "string" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "tests": {
      "type": "object",
      "properties": { "chatModel": { "type": "string" } }
    }
  }
}
