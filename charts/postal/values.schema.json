{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "hostname": {
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*$"
    },
    "probe": {
      "type": ["object", "null"]
    },
    "resources": {
      "type": "object"
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "pathType"],
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array" }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    }
  },
  "properties": {
    "image": { "$ref": "#/definitions/image" },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "postal": {
      "type": "object",
      "properties": {
        "webHostname": { "$ref": "#/definitions/hostname" },
        "webProtocol": { "type": "string", "enum": ["http", "https"] },
        "smtpHostname": { "$ref": "#/definitions/hostname" },
        "secretKey": { "type": "string" },
        "signingKey": { "type": "string" },
        "existingSecret": { "type": "string" },
        "secretKeyKey": { "type": "string", "minLength": 1 },
        "signingKeyKey": { "type": "string", "minLength": 1 },
        "trustedProxies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "smtpRelays": { "type": "array", "items": { "type": "string", "pattern": "^smtp://" } }
      }
    },
    "dns": {
      "type": "object",
      "properties": {
        "mxRecords": { "type": "array", "items": { "$ref": "#/definitions/hostname" } },
        "spfInclude": { "$ref": "#/definitions/hostname" },
        "returnPathDomain": { "$ref": "#/definitions/hostname" },
        "routeDomain": { "$ref": "#/definitions/hostname" },
        "trackDomain": { "$ref": "#/definitions/hostname" },
        "heloHostname": { "$ref": "#/definitions/hostname" },
        "dkimIdentifier": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "username": { "type": "string", "minLength": 1 },
        "password": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "messageDatabasePrefix": { "type": "string", "minLength": 1 }
      }
    },
    "systemEmail": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 },
        "fromName": { "type": "string" },
        "fromAddress": { "type": "string", "pattern": "^$|^[^@\\s]+@[^@\\s]+$" }
      }
    },
    "admin": {
      "type": "object",
      "properties": {
        "email": { "type": "string", "pattern": "^$|^[^@\\s]+@[^@\\s]+$" },
        "firstName": { "type": "string", "minLength": 1 },
        "lastName": { "type": "string", "minLength": 1 },
        "password": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "maxThreads": { "type": "integer", "minimum": 1 },
        "service": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "lifecycle": { "type": "object" },
        "startupProbe": { "$ref": "#/definitions/probe" },
        "livenessProbe": { "$ref": "#/definitions/probe" },
        "readinessProbe": { "$ref": "#/definitions/probe" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "ingress": { "$ref": "#/definitions/ingress" },
    "smtp": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535, "not": { "enum": [9091] } },
        "bindAddress": { "type": "string", "minLength": 1 },
        "maxMessageSize": { "type": "integer", "minimum": 1 },
        "proxyProtocol": { "type": "boolean" },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "ports": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "port"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                  "nodePort": { "type": "integer", "minimum": 1, "maximum": 65535 }
                }
              }
            },
            "externalTrafficPolicy": { "type": "string", "enum": ["", "Cluster", "Local"] },
            "loadBalancerIP": { "type": "string" },
            "annotations": { "type": "object" }
          }
        },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "startupProbe": { "$ref": "#/definitions/probe" },
        "livenessProbe": { "$ref": "#/definitions/probe" },
        "readinessProbe": { "$ref": "#/definitions/probe" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "threads": { "type": "integer", "minimum": 1 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "livenessProbe": { "$ref": "#/definitions/probe" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "podMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" },
            "labels": { "type": "object" }
          }
        }
      }
    },
    "migrations": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  }
}
