{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "secrets": {
      "type": "object",
      "properties": {
        "masterKey": { "type": "string" },
        "secretKey": { "type": "string" },
        "providerAccountPepper": { "type": "string" },
        "providerUserIdentifierKey": { "type": "string" },
        "existingSecret": { "type": "string" }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "pattern": "^(postgres(ql)?(\\+asyncpg)?://.+)?$" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "migrations": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "resources": { "type": "object" }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "pattern": "^(rediss?://.+)?$" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "files": {
      "type": "object",
      "properties": {
        "backend": { "enum": ["local", "s3"] },
        "s3": {
          "type": "object",
          "properties": {
            "bucket": { "type": "string" },
            "endpointUrl": { "type": "string", "pattern": "^(https?://.+)?$" },
            "region": { "type": "string" },
            "existingSecret": { "type": "string" },
            "accessKeyIdKey": { "type": "string", "minLength": 1 },
            "secretAccessKeyKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "publicBaseUrl": { "type": "string", "pattern": "^(https?://[^/]+(/.*[^/])?)?$" },
    "forwardedAllowIps": { "type": "string" },
    "bootstrapApiKey": { "type": "boolean" },
    "logLevel": { "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL", "debug", "info", "warning", "error", "critical"] },
    "config": { "type": "object" },
    "existingConfigMap": { "type": "string" },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" },
            "labels": { "type": "object" }
          }
        }
      }
    },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany", "ReadOnlyMany"] }
        },
        "size": { "type": "string", "minLength": 1 },
        "annotations": { "type": "object" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "ingress": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "parentRefs": { "type": "array" },
        "hostnames": { "type": "array" }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "podDisruptionBudget": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "from": { "type": "array" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
    "preStopSleepSeconds": { "type": "integer", "minimum": 0 },
    "probes": {
      "type": "object",
      "properties": {
        "startupFailureThreshold": { "type": "integer", "minimum": 1 },
        "livenessFailureThreshold": { "type": "integer", "minimum": 1 },
        "readinessFailureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "tests": { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
  }
}
